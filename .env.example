# Groq - the only key needed for the core assessment deliverable.
# Free tier: ~30 RPM, 8k TPM on gpt-oss-120b. https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides. Roles, not names, are what the code refers to.
# GROQ_GENERATOR_MODEL=openai/gpt-oss-120b
# GROQ_REASONER_MODEL=qwen/qwen3.8-27b
# GROQ_GRADER_MODEL=openai/gpt-oss-20b

# Phase 5. Google AI Studio, free tier: 90 RPM / 950 RPD / 27k TPM.
# Groq has no embeddings endpoint, which is why embeddings come from Google.
GEMINI_API_KEY=

# "lexical" = BM25 + metadata filter. "hybrid" adds dense retrieval + RRF.
RETRIEVAL_MODE=lexical

# "files" = parse runbooks/ into memory. "supabase" = read from Postgres.
STORE_BACKEND=files

# Phase 6.
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Phase 7.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
