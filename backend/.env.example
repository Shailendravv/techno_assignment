# Secrets only. Everything tunable - thresholds, model roles, which embedder,
# which store - lives in config/local.json and config/dev.json, which are
# committed. A real environment variable always wins over a profile.
#
# Copy to `.env`. It is gitignored.

# --------------------------------------------------------------------------
# Which profile to load: "local" (default) or "dev".
#
#   local  files + fastembed/bge-small, offline and deterministic. What the
#          test suite and the evaluation harness use.
#   dev    Supabase + Gemini. What the deployed Vercel function uses, because
#          ~200MB of onnxruntime has no business in a serverless bundle.
# --------------------------------------------------------------------------
APP_ENV=local

# --------------------------------------------------------------------------
# Groq - the only key needed for the core assessment deliverable.
# Free tier: ~30 RPM, 8k TPM on gpt-oss-120b. https://console.groq.com/keys
#
# Without it, retrieval and every `no_match` path still work and the whole test
# suite passes. Only the grounding step needs a model.
# --------------------------------------------------------------------------
GROQ_API_KEY=

# Optional. Roles, not names, are what the code refers to - so swapping a model
# is a config change, never a code change. qwen is a *preview* model and can
# change or vanish without notice; gpt-oss-120b is the production default.
# GROQ_GENERATOR_MODEL=openai/gpt-oss-120b
# GROQ_REASONER_MODEL=qwen/qwen3.8-27b
# GROQ_GRADER_MODEL=openai/gpt-oss-20b

# --------------------------------------------------------------------------
# Google AI Studio, for embeddings in the deployed profile.
# Free tier: 90 RPM / 950 RPD / 27k TPM, 250 texts per request.
# Groq has no embeddings endpoint, which is why embeddings come from Google.
#
# Not needed locally: APP_ENV=local uses fastembed instead.
# --------------------------------------------------------------------------
GEMINI_API_KEY=

# --------------------------------------------------------------------------
# Supabase. Needed only for APP_ENV=dev.
#
# Use the SERVICE key, and only from the server. It bypasses row-level
# security, which is why RLS is enabled with no permissive policy: if the anon
# key ever leaks into a browser bundle, it reads nothing.
#
# Setup:  run supabase/migrations/*.sql in order, then
#         python -m ingest.pipeline --seed --profile dev
# --------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --------------------------------------------------------------------------
# Signed uploads. `POST /ingest/sign` is DISABLED unless this is set - it
# returns 404, not 403, so an unconfigured deployment does not advertise the
# route at all.
#
# It needs a secret because of what is downstream of it, not because the
# signature itself is precious: `ingest.pipeline --from-cloudinary` turns
# whatever lands in the folder into corpus documents, taking doc_id, service
# and failure_mode from the uploaded file's own front-matter and handing its
# body to a model as ground truth. An open endpoint here lets a caller choose
# what the agent believes.
#
#   openssl rand -hex 32
# --------------------------------------------------------------------------
INGEST_API_KEY=

# --------------------------------------------------------------------------
# Cloudinary. Needed only for the document upload path.
#
# Everything is stored as resource_type: raw, because free accounts block PDF
# delivery by default and raw is not subject to that rule.
# --------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=runbooks

# --------------------------------------------------------------------------
# Langfuse tracing. Entirely optional - the per-stage trace is always available
# locally via `--trace` and over HTTP via {"explain": true}. This ships it
# somewhere durable, with the model, token usage and latency of every Groq call
# attached. Off unless both keys are set.
#
# The host must match the region the keys were issued in. Sending EU keys to
# the US origin fails authentication rather than silently going elsewhere, but
# it is still ten confusing minutes.
# --------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com   # EU. US: https://us.cloud.langfuse.com

# Off switch that does not require deleting the keys. Keys are shared between
# the app, the CLI and the harness, and "stop sending traces from this run"
# should not mean editing credentials. The test suite sets this to false for
# every test, so `pytest` never reaches Langfuse even on a machine with keys.
# LANGFUSE_TRACING_ENABLED=false

# Which Langfuse environment traces land in. Defaults to APP_ENV, so a local
# run and a deployed one do not share dashboards or evaluations.
# LANGFUSE_TRACING_ENVIRONMENT=local

# --------------------------------------------------------------------------
# CORS. Browser origins allowed to call this API. Comma-separated. Defaults to
# the Vite dev server, so `npm run dev` in frontend/ works against a local
# `uvicorn app.main:app --reload` with no setup. Add the deployed frontend's
# origin here when hosting for real.
# --------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------------------
# Overrides. Normally leave these to the profile; set one to answer a "what if"
# without editing a committed file.
# --------------------------------------------------------------------------
# Requests per minute per client IP on POST /ask. Every request that clears the
# gate spends Groq tokens from a shared 8k-per-minute free tier, and the
# endpoint takes no credential. In-process, so the effective limit is this times
# the number of warm instances. 0 disables it.
# ASK_RATE_LIMIT_PER_MINUTE=20

# RETRIEVAL_MODE=hybrid     # or "lexical"
# STORE_BACKEND=files       # or "supabase"
# EMBEDDER=local            # "local" | "gemini" | "none"
# GRADER_ENABLED=false      # the CRAG relevance grader: one extra call/question
# ANSWER_CACHE=false
# ANSWER_CACHE_TTL_S=60     # how long an answer may be served. 0 = no expiry.
#                           # Raise it to get the quota protection the cache
#                           # exists for; lower it to bound how long a stale
#                           # answer can outlive a change nobody versioned.
# COVERAGE_FLOOR=0.60       # calibrated; see WRITEUP.md section 3
# COSINE_FLOOR=0.75
